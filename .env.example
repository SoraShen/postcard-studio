# --- Gemini key ---
# Browser mode: VITE_GEMINI_API_KEY or GEMINI_API_KEY (injected at build; not ideal for public deploy).
# Backend proxy: only GEMINI_API_KEY on the machine running `npm run server` (never expose VITE_* for the secret).
GEMINI_API_KEY=your_key_here
# VITE_GEMINI_API_KEY=your_key_here

# --- Backend proxy (optional) ---
# Static site on https://alexsora.xyz + Gemini via Worker on https://ai.alexsora.xyz — use:
# VITE_USE_GEMINI_PROXY=true
# VITE_GEMINI_WORKER_BASE=https://ai.alexsora.xyz
# (Worker must proxy /v1beta to Google and allow CORS from https://alexsora.xyz)
# Frontend calls POST /api/generate-postcard; Vite dev proxies /api -> http://127.0.0.1:8787
# Run: npm run dev:all   (or two terminals: npm run server + npm run dev)
# GEMINI_PROXY_PORT=8787
# Cross-origin SPA: set allowed origins (comma-separated)
# GEMINI_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
# Custom API host (no trailing slash); leave unset to use same-origin /api
# VITE_GEMINI_BACKEND_URL=https://api.yourdomain.com

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
